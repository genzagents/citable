{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.genzagents/citable",
  "title": "citable",
  "description": "Can ChatGPT, Claude and Perplexity read and cite your site? robots.txt, edge blocks, llms.txt.",
  "websiteUrl": "https://genzagents.github.io/citable/",
  "repository": {
    "url": "https://github.com/genzagents/citable",
    "source": "github"
  },
  "version": "0.4.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "citable-cli",
      "version": "0.4.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the MCP server over stdio"
        }
      ]
    }
  ]
}
